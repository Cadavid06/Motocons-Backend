APP_NAME=MOTOCONS
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000
APP_CSRF=true

# Base de datos local (SQLite). Si se deja vacío se usa database/database.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=

# Base de datos PostgreSQL (Neon Cloud o local)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=motocons_db
# DB_USERNAME=postgres
# DB_PASSWORD=tu_password_aqui
# DB_SSLMODE=prefer

# Ruta pública de archivos adjuntos (opcional)
# STORAGE_PATH=/ruta/absoluta/storage/app/public
